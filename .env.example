# Database
# Local dev: a SQLite file. Production: a libsql/Turso URL, e.g. libsql://your-db.turso.io
DATABASE_URL="file:./dev.db"
# Only needed for remote libsql (Turso) databases
# DATABASE_AUTH_TOKEN=""

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
# Base URL of the deployed site (not needed on Vercel)
# NEXTAUTH_URL="https://your-domain.com"

# Stripe (dashboard.stripe.com → Developers → API keys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Stripe webhook signing secret (Developers → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Store admin account, created/promoted by `npm run db:seed`
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-please"
