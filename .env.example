# Database
# Local dev: a SQLite file. Production: a libsql/Turso URL, e.g. libsql://your-db.turso.io
DATABASE_URL="file:./dev.db"
# Only needed for remote libsql (Turso) databases
# DATABASE_AUTH_TOKEN=""

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
# Base URL of the deployed site (not needed on Vercel)
# NEXTAUTH_URL="https://your-domain.com"

# Payment methods offered at checkout:
#   Card (Stripe)     — enabled when STRIPE_SECRET_KEY is set
#   Bank transfer     — enabled when BANK_TRANSFER_DETAILS is set
#   Cash on delivery  — enabled unless CASH_ON_DELIVERY="false"
# Shown to customers on their order page. Use real line breaks, or "\n".
# BANK_TRANSFER_DETAILS="Bank: Example Bank\nAccount name: sċoppa\nAccount number: 0000000000\nBranch: Main"
# CASH_ON_DELIVERY="false"

# Stripe (dashboard.stripe.com → Developers → API keys). Optional — leave
# unset to turn off card payments.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Stripe webhook signing secret (Developers → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Store admin account, created/promoted by `npm run db:seed`
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-please"
